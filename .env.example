# Model APIs are disabled. Model subscriptions remain in their iOS apps.

# Sign in with Apple web credentials are server-only secrets. See docs/APPLE-AUTH.md.
APPLE_AUTH_TEAM_ID=
APPLE_AUTH_KEY_ID=
APPLE_AUTH_CLIENT_ID=
APPLE_AUTH_NATIVE_CLIENT_ID=com.dezocode.LocalSandbox
APPLE_AUTH_REDIRECT_URI=
APPLE_AUTH_PRIVATE_KEY_P8=
APPLE_AUTH_STORAGE_KEY=

# Cursor Origin App credentials are server-only. See docs/ORIGIN.md.
ORIGIN_APP_ID=
ORIGIN_APP_PRIVATE_KEY_PKCS8=
ORIGIN_INSTALL_REDIRECT_URI=
ORIGIN_INSTALL_SCOPES=repository:contents:read
ORIGIN_INSTALL_SUMMARY=Show approved repositories and request an explicit mirror refresh.
